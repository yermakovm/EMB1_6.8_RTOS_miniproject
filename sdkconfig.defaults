# Target must match the board (ESP32-S3)
CONFIG_IDF_TARGET="esp32s3"

# Board: ESP32-S3-DevKitC-1-N16R8V (16 MB flash; PSRAM is not used by this app)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Dedicated partition for binary log records (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Light Sleep: FreeRTOS tickless idle. IDF's IDLE task calls esp_light_sleep_start()
# when all 5 tasks are blocked, which is the case between the 1-second wake cycles.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=2
CONFIG_FREERTOS_HZ=1000
